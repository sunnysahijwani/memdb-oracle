# /etc/nginx/sites-available/memdb.example.com  — replace the hostname, then:
#   ln -s /etc/nginx/sites-available/memdb.example.com /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d memdb.example.com      (adds the 443 block + auto-renew)
server {
    listen 80;
    server_name memdb.example.com;

    location / {
        proxy_pass         http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;   # rate limit keys on this
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Server-sent events: no buffering, long read timeout (a turn can take 60-90 s)
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        chunked_transfer_encoding on;
    }
}
