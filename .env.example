# Anthropic — the agent runs on the Claude API (MCP connector calls Sanity server-side)
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
EFFORT=high

# Sanity — ORGANIZATION-level token with "Context Viewer" permission (project tokens are rejected)
SANITY_ORG_ID=
SANITY_CONTEXT_TOKEN=
SANITY_MCP_NAME=memdb
# Optional second endpoint that serves only the Knowledge Base (avoids two connections to one URL)
SANITY_KB_MCP_NAME=memdb-kb
# Public dataset (for the post + Studio); the agent itself only needs the two lines above
SANITY_PROJECT_ID=
SANITY_DATASET=production
